<Window x:Class="Assignment2c.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment2c"
        mc:Ignorable="d"
        Title="Weapon Editor" Height="500" Width="450" Background="Silver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="129*"/>
            <RowDefinition Height="355*"/>
        </Grid.RowDefinitions>
        <Button x:Name="LoadButton" Content="Load" HorizontalAlignment="Left" Margin="28,23,0,0" VerticalAlignment="Top" Height="23" Width="62" Click="LoadButton_Click"/>
        <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Left" Margin="117,23,0,0" VerticalAlignment="Top" Height="23" Width="62" Click="SaveButton_Click"/>
        <GroupBox Header="Sort by:" Width="404" Grid.Row="0" HorizontalAlignment="Center" Height="100" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,60,0,0">
            <WrapPanel Orientation="Horizontal" UseLayoutRounding="False">
                <RadioButton GroupName="SortGroup" Content="Name" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,10,10" Checked="SortRadio_Checked"/>
                <RadioButton GroupName="SortGroup" Content="BaseAttack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,10,10" Checked="SortRadio_Checked"/>
                <RadioButton GroupName="SortGroup" Content="Rarity" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,10,10" Checked="SortRadio_Checked"/>
                <RadioButton GroupName="SortGroup" Content="Passive" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1" Margin="10,10,10,10" Padding="4,-1,0,0" Checked="SortRadio_Checked"/>
                <RadioButton GroupName="SortGroup" Content="SecondaryStat" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1" Margin="10,10,11,10" Checked="SortRadio_Checked"/>
            </WrapPanel>
        </GroupBox>
        <ComboBox x:Name="ShowTypeComboBox" HorizontalAlignment="Left" Margin="117,48,0,0" VerticalAlignment="Top" Width="205" Grid.Row="1"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,48,0,0" TextWrapping="Wrap" Text="Show only type:" VerticalAlignment="Top" Grid.Row="1"/>
        <ListBox x:Name="WeaponsListBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,121,117,10" Grid.Row="1"/>
        <Button x:Name="AddWeaponButton" Content="Add" HorizontalAlignment="Right" Margin="365,121,10,0" VerticalAlignment="Top" Height="23" Width="62" Grid.Row="1" Click="AddButton_Click"/>
        <Button x:Name="EditWeaponButton" Content="Edit" IsEnabled="{Binding SelectedItem, ElementName=WeaponsListBox}" HorizontalAlignment="Right" Margin="365,149,10,0" VerticalAlignment="Top" Height="23" Width="62" Grid.Row="1" Click="EditWeaponButton_Click"/>
        <Button x:Name="RemoveWeaponButton" Content="Remove" IsEnabled="{Binding SelectedItem, ElementName=WeaponsListBox}" HorizontalAlignment="Right" Margin="365,177,10,0" VerticalAlignment="Top" Height="23" Width="62" Grid.Row="1" Click="RemoveWeapon_Click"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,86,0,0" TextWrapping="Wrap" Text="Filter by name:" VerticalAlignment="Top" Grid.Row="1"/>
        <TextBox x:Name="FilterByNameBox" HorizontalAlignment="Left" Margin="117,86,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="205" TextChanged="FilterByNameBox_TextChanged"/>

    </Grid>
</Window>
